{
  "name": "token-coach",
  "displayName": "Token Coach",
  "description": "Reads GitHub Copilot's local debug logs and coaches you toward cheaper token usage by surfacing cost (NanoAiu) and cache hit rates.",
  "version": "2.6.1",
  "publisher": "NadavLAN",
  "license": "Apache-2.0",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Landsmanadav/copilot-token-coach.git"
  },
  "bugs": {
    "url": "https://github.com/Landsmanadav/copilot-token-coach/issues"
  },
  "homepage": "https://github.com/Landsmanadav/copilot-token-coach#readme",
  "qna": "marketplace",
  "galleryBanner": {
    "color": "#1E1E1E",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "copilot",
    "github copilot",
    "tokens",
    "cost",
    "credits",
    "cache",
    "usage",
    "ai",
    "aiu"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "tokenCoach.showDashboard",
        "title": "Token Coach: Show Dashboard",
        "icon": "$(graph)"
      },
      {
        "command": "tokenCoach.refresh",
        "title": "Token Coach: Refresh Logs",
        "icon": "$(refresh)"
      },
      {
        "command": "tokenCoach.exportReport",
        "title": "Token Coach: Export Report (per session JSON, Markdown, CSV)",
        "icon": "$(save)"
      },
      {
        "command": "tokenCoach.openSettings",
        "title": "Token Coach: Open Settings",
        "icon": "$(gear)"
      },
      {
        "command": "tokenCoach.enableLogging",
        "title": "Token Coach: Enable Copilot Logging",
        "icon": "$(check)"
      }
    ],
    "configuration": [
      {
        "title": "Token Coach",
        "properties": {
          "tokenCoach.showCostsIn": {
            "type": "string",
            "enum": [
              "dollars",
              "credits"
            ],
            "enumDescriptions": [
              "Show costs in US dollars (1 credit = $0.01), with credits alongside.",
              "Show credits only, no dollar amounts."
            ],
            "default": "dollars",
            "order": 1,
            "markdownDescription": "**Show costs in** dollars or credits, across the status bar, dashboard and report."
          },
          "tokenCoach.popups": {
            "type": "boolean",
            "default": true,
            "order": 2,
            "markdownDescription": "**Show popups** when a single request is expensive, or when a message wastes money in a fixable way (at most one tip every 5 minutes). Popups close by themselves after a few seconds."
          }
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.4.0"
  }
}
